# Copy to .env and keep that file private. scripts/setup.sh creates it automatically.
SDN_MININET_PYTHON=
ANTI_SDN_RUNTIME_DIR=
SDN_UNBLOCK_IPC_PATH=/tmp/unblock_requests.txt

BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000
BACKEND_URL=http://127.0.0.1:5000
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=5173
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:5000
RYU_HOST=127.0.0.1
RYU_PORT=6653

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sdn_security
DB_USER=sdn_user
DB_PASSWORD=

# Optional notifications. Never commit real credentials.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECEIVER=

# Optional dataset collection settings.
SDN_DATASET_ENABLED=0
SDN_DATASET_PATH=
SDN_DATASET_STATE_PATH=/tmp/sdn_experiment_state.json
